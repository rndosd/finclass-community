# Copy to .env.local; replace EVERY example with your own Firebase Web app.
# REACT_APP_* values are embedded in the browser bundle. Never put secrets here.
REACT_APP_FINCLASS_ENVIRONMENT=production
REACT_APP_FIREBASE_API_KEY=replace-with-your-web-api-key
REACT_APP_FIREBASE_PROJECT_ID=your-finclass-project
REACT_APP_FIREBASE_EXPECTED_PROJECT_ID=your-finclass-project
REACT_APP_FIREBASE_AUTH_DOMAIN=your-finclass-project.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=your-finclass-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:replace-me
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_GOOGLE_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
REACT_APP_PUBLIC_ORIGIN=https://your-finclass-project.web.app
REACT_APP_CANONICAL_REDIRECT_HOSTS=
REACT_APP_ROBOTS_CONTENT=noindex,nofollow
# Register your site in Firebase App Check before enabling enforcement.
REACT_APP_APPCHECK_ENABLED=true
REACT_APP_APPCHECK_ENTERPRISE_SITE_KEY=replace-with-your-enterprise-site-key
# Localhost-only debug token; never put an actual token in a production build.
REACT_APP_APPCHECK_DEBUG_TOKEN=
REACT_APP_USE_EMULATORS=false
REACT_APP_SUPPORT_URL=
