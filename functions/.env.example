# Copy non-secret configuration to functions/.env.YOUR_PROJECT_ID.
# Provider secrets belong in Firebase Secret Manager, not this file.
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_BUCKET_NAME=replace-with-your-r2-bucket-name
R2_PUBLIC_URL=https://media.example.invalid
UPLOAD_ALLOWED_ORIGINS=https://your-finclass-project.web.app,http://localhost:3000
SEC_API_USER_AGENT=YourClassEconomy/1.0 (contact: operator@example.invalid)
ENFORCE_APPCHECK=true
